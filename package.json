{
  "name": "linked-data-python-highlight",
  "version": "0.1.0",
  "description": "Syntax highlighting for Linked-Data Python (.ldpy): one island lexicon, four backends (TextMate, highlight.js, Prism, Pygments).",
  "license": "Apache-2.0",
  "author": "Maxime Lefrançois",
  "repository": "gitlab:coswot/highlight-ldpy",
  "keywords": ["ldpy", "linked-data-python", "rdf", "turtle", "sparql", "syntax-highlighting", "highlight.js", "prism", "textmate"],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./highlightjs": "./src/highlightjs.js",
    "./prism": "./src/prism.js",
    "./textmate": "./src/textmate.js",
    "./islands": "./src/islands.js"
  },
  "files": ["src/", "vendor/", "README.md", "LICENSE.md"],
  "scripts": {
    "generate": "node src/cli-generate.js",
    "test": "node test/run.js"
  },
  "peerDependencies": {
    "highlight.js": "^11.0.0",
    "prismjs": "^1.29.0"
  },
  "peerDependenciesMeta": {
    "highlight.js": { "optional": true },
    "prismjs": { "optional": true }
  },
  "devDependencies": {
    "highlight.js": "^11.11.1",
    "prismjs": "^1.30.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  }
}
